# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environment
.venv/
venv/

# Runtime session working dirs
sessions/

# Raw participant data (privacy-sensitive; never commit)
# (data/* not data/, so the one public asset below can be re-included)
data/*
# ...except the public SkyTrain track geometry the app bundles (TransLink GTFS)
!data/skytrain.geojson

# Build artifacts
build/
dist/
*.spec
!trip_review.spec

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Personal Claude Code overrides (model choice etc.; not team-shared)
.claude/settings.local.json

# Excel lock files
~$*.xlsx

# Dev-server log dumps (leak session ids / participant accessCodes)
flask_out.txt
flask_err.txt

# Generated outputs (charts + the prototype viewer embed real GPS; regenerable)
analysis/output/
prototype/viewer.html
